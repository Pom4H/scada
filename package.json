{
  "name": "@pom4h/scada",
  "version": "0.1.0",
  "description": "Source-first SCADA playground. Drag equipment, edit TypeScript, keep one source of truth.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lab.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test && npm run test:runtime:e2e",
    "check": "npm run build && npm run server:build && npm run typecheck && npm test && npm run test:runtime && npm run challenge:core && npm run lab:test && npm run lab:build",
    "challenge": "node scripts/challenge.mjs",
    "challenge:core": "node scripts/challenge.mjs core",
    "challenge:browser": "node scripts/challenge.mjs browser",
    "challenge:bench": "node scripts/challenge.mjs bench",
    "lab:build": "node scripts/lab-build.mjs",
    "lab": "node scripts/lab-build.mjs --serve",
    "lab:test": "node scripts/lab-test.mjs",
    "lab:capture": "node scripts/lab-capture.mjs",
    "server:build": "node scripts/server-build.mjs",
    "server": "npm run server:build && node .server/cli.mjs",
    "demo": "npm run build && npm run server",
    "test:runtime": "node scripts/server-test.mjs && node scripts/runtime-qa-test.mjs",
    "test:runtime:e2e": "playwright test -c playwright.runtime.config.ts"
  },
  "keywords": [],
  "author": "Roman Popov",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@typescript/typescript6": "6.0.2",
    "codemirror": "6.0.2",
    "three": "0.185.1"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pom4H/scada.git"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/three": "0.185.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
